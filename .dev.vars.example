# Server-only settings. Copy to .dev.vars for local development and set the
# same names as secrets/variables on the host. Never commit the filled file.

# supabase: invite-only email/password sign-in and the shared database.
# local: unprotected preview that saves in the browser; only works in
# development on localhost and never in a production build.
AUTH_MODE=supabase

# Supabase project URL (https://<project-ref>.supabase.co) and its publishable
# key. Never use a service-role or secret key here.
SUPABASE_URL=https://ivpnwmpyoauymvjtjwmd.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_r-Y7LuRlb_yE5yTWwP3LxA_Zd0ZLqVH

# Reading load tickets. The key is used only on the server, in
# app/api/extract/route.ts, and is never sent to the browser. Set it as a secret
# on the host — never in vite.config.ts vars, which are committed.
#
# One Monius key for every client workspace on this deployment. Which company a
# ticket belongs to is decided by the signed-in member's workspace, not by the
# key, so there is no per-client variable to add when a client is onboarded.
OPENAI_API_KEY=sk-...

# IFTA & Mileage. Geocodes ticket addresses and routes trucks, on the server
# only (lib/server/tomtom-key.ts); never sent to the browser. Set it as a
# secret on the host — never in vite.config.ts vars, which are committed.
# One Monius key for every client workspace, like the OpenAI key. Without it
# the IFTA page says routing is not configured and everything else still works.
TOMTOM_API_KEY=...

# Rate & Fuel Agent. How far the agent may go on its own when it has written a
# request for a customer's rates: DRAFT_ONLY writes the email and stops,
# APPROVAL_REQUIRED lets a person send it, AUTO_SEND lets the agent. Anything
# else — unset, misspelt — reads as DRAFT_ONLY, and a customer's own send mode
# is capped by this, so a profile cannot outrun the deployment.
#
# V1 has no mail adapter at all (lib/server/rate-mail.ts), so nothing is
# emailed whatever this says; the two settings above become real the day a
# mailbox is connected there.
RATE_MAIL_MODE=DRAFT_ONLY

# The stand-ins for that missing mailbox: marking a request sent, and typing a
# reply as if the customer had sent it, so the agent can be walked end to end
# before there is one. 'true' turns them on; they are also on in the local
# preview. Never set on a client deployment.
RATE_DEV_TOOLS=false
